# ─── Copy file này thành .env rồi điền giá trị thật ───
# cp .env.example .env

# LLM (Google AI Studio: https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Neo4j AuraDB (https://console.neo4j.io)
# Lưu ý: NEO4J_USERNAME = Instance ID (không phải "neo4j")
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USERNAME=<instance-id>
NEO4J_PASSWORD=your_auradb_password_here
NEO4J_DATABASE=<instance-id>

# Qdrant (local in-memory for dev, no key needed)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# App Config
LOG_LEVEL=INFO
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Model Cache (đổi sang ổ D hoặc ổ có nhiều dung lượng)
# HF_HOME=D:\path\to\models\huggingface
# SENTENCE_TRANSFORMERS_HOME=D:\path\to\models\sentence_transformers
